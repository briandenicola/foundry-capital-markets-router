      "link": null,
      "locked": false,
      "text": "Routing/RouteRequestHandler.cs — POST /v1/route. Translates HTTP only.\nContracts/RouteRequestValidator.cs · Routing/RouteStatusMapper.cs\nConfiguration/ModelCatalog.cs + RouterOptions.cs\nSecurity/RouterAuthorization.cs — Router.Invoke app role\nCorrelation/CorrelationIdMiddleware.cs — one id, end to end\nPersistence/{RoutingDecisionStore, CosmosRoutingDecisionStore, CosmosClientFactory}.cs\nTelemetry/TelemetryRegistration.cs · Health/DecisionStoreHealthCheck.cs",
      "originalText": "Routing/RouteRequestHandler.cs — POST /v1/route. Translates HTTP only.\nContracts/RouteRequestValidator.cs · Routing/RouteStatusMapper.cs\nConfiguration/ModelCatalog.cs + RouterOptions.cs\nSecurity/RouterAuthorization.cs — Router.Invoke app role\nCorrelation/CorrelationIdMiddleware.cs — one id, end to end\nPersistence/{RoutingDecisionStore, CosmosRoutingDecisionStore, CosmosClientFactory}.cs\nTelemetry/TelemetryRegistration.cs · Health/DecisionStoreHealthCheck.cs",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
