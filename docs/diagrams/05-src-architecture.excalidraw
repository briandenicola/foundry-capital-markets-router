    {
      "id": "txt-083",
      "type": "text",
      "x": 1416,
      "y": 1856,
      "width": 1368,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 413929035,
      "versionNonce": 1279167535,
      "version": 1,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Start at src/Fcmr.Router.Decisions. It has no dependencies, it holds every routing rule, and it is the only assembly the demo's central claim actually\nrests on — governance decides, the application does not.\nThen src/Fcmr.Approvals.Domain, which holds the human gate and, deliberately, no ability to act on it.\nThe services above them are thin on purpose: if you find a rule inside an endpoint, that is a defect, not a shortcut.\nEverything in the dashed red band is absent, not hidden. The demo can currently prove its governance and its privacy; it cannot yet prove an end-to-end\nmodel call, and it does not pretend to.",
      "originalText": "Start at src/Fcmr.Router.Decisions. It has no dependencies, it holds every routing rule, and it is the only assembly the demo's central claim actually rests on — governance decides, the application does not.\nThen src/Fcmr.Approvals.Domain, which holds the human gate and, deliberately, no ability to act on it.\nThe services above them are thin on purpose: if you find a rule inside an endpoint, that is a defect, not a shortcut.\nEverything in the dashed red band is absent, not hidden. The demo can currently prove its governance and its privacy; it cannot yet prove an end-to-end model call, and it does not pretend to.",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
    }
  ],
