      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "① Lane service  ·  the CUSTODIAN",
      "originalText": "① Lane service  ·  the CUSTODIAN",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": "box-003",
      "lineHeight": 1.25
    },
    {
      "id": "txt-005",
      "type": "text",
      "x": 96,
      "y": 291,
      "width": 538,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2040956068,
      "versionNonce": 1046882220,
      "version": 1,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "C# on Container Apps. It is not the agent.\n\n1. stamps correlationId BEFORE thread creation\n2. creates ONE thread for ONE business request —\nthreads are never reused, because carried-over\ncontext makes cost and reproducibility\nunexplainable and both are demo claims\n3. supplies the tool surface\n4. enforces the approval halt\n5. writes the audit record\n\nStep budget: exceed it and the agent halts, returns\npartial work, and logs. An agent that loops on stage\nis worse than one that stops.",
      "originalText": "C# on Container Apps. It is not the agent.\n\n1. stamps correlationId BEFORE thread creation\n2. creates ONE thread for ONE business request —\n   threads are never reused, because carried-over\n   context makes cost and reproducibility\n   unexplainable and both are demo claims\n3. supplies the tool surface\n4. enforces the approval halt\n5. writes the audit record\n\nStep budget: exceed it and the agent halts, returns\npartial work, and logs. An agent that loops on stage\nis worse than one that stops.",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
    },
