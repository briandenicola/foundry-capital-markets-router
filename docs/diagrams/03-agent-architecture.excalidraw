      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The model produces SCORES",
      "originalText": "The model produces SCORES",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": "box-044",
      "lineHeight": 1.25
    },
    {
      "id": "txt-046",
      "type": "text",
      "x": 136,
      "y": 1341,
      "width": 821.33,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
