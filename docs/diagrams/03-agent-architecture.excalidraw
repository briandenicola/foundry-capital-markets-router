      "version": 1,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The ordering is applied by the lane service, not by the model.\nThis is the single design choice that makes AC-6 achievable:\nsame seed and same inputs produce the same order, provably,\non stage. A free-running agent over 500 alerts would not.",
      "originalText": "The ordering is applied by the lane service, not by the model.\nThis is the single design choice that makes AC-6 achievable:\nsame seed and same inputs produce the same order, provably,\non stage. A free-running agent over 500 alerts would not.",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
