      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "BOUNDARY 1 — network enforced:  THE AGENT'S MODEL ACCESS IS THE ROUTER'S",
      "originalText": "BOUNDARY 1 — network enforced:  THE AGENT'S MODEL ACCESS IS THE ROUTER'S",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": "box-024",
      "lineHeight": 1.25
    },
    {
      "id": "txt-026",
      "type": "text",
      "x": 96,
      "y": 875,
      "width": 2728,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1278841812,
      "versionNonce": 259429750,
      "version": 1,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Only the router-service identity holds \"Azure AI Developer\" on the Foundry project (apps/roles.tf). The lane services have no such assignment and no route to the Foundry data plane.\nThis is not a convention enforced by code review. It is the reason the cost ceiling is a control rather than a reporting feature: a ceiling services could bypass would be advisory.",
      "originalText": "Only the router-service identity holds \"Azure AI Developer\" on the Foundry project (apps/roles.tf). The lane services have no such assignment and no route to the Foundry data plane.\nThis is not a convention enforced by code review. It is the reason the cost ceiling is a control rather than a reporting feature: a ceiling services could bypass would be advisory.",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
    },
