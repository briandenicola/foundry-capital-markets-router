    {
      "id": "txt-022",
      "type": "text",
      "x": 96,
      "y": 673,
      "width": 2728,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
