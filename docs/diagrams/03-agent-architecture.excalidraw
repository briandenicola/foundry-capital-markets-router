      "version": 1,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "An approval persists approver identity, timestamp, decision and\nthe full evidence packet presented at decision time.\nAn unapproved proposal EXPIRES. It never auto-executes on\ntimeout — a gate that opens on inaction is not a gate.",
      "originalText": "An approval persists approver identity, timestamp, decision and\nthe full evidence packet presented at decision time.\nAn unapproved proposal EXPIRES. It never auto-executes on\ntimeout — a gate that opens on inaction is not a gate.",
