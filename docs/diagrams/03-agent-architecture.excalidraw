      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Specified for token metering, cost ceilings and content safety in\ndocs/architecture.md and the constitution. No APIM resource exists\nin either stack today, so the ceiling is currently enforced in one\nplace (the router) rather than two.",
      "originalText": "Specified for token metering, cost ceilings and content safety in\ndocs/architecture.md and the constitution. No APIM resource exists\nin either stack today, so the ceiling is currently enforced in one\nplace (the router) rather than two.",
