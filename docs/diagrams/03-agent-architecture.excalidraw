      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Conclusion: the agent reasons but the service is accountable — two network-enforced boundaries stop the agent reaching a model or a tool reaching a model, and no consequential action leaves the system without a human.",
      "originalText": "Conclusion: the agent reasons but the service is accountable — two network-enforced boundaries stop the agent reaching a model or a tool reaching a model, and no consequential action leaves the system without a human.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
    },
