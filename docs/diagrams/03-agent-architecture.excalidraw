      "version": 1,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "BOUNDARY 2 — network enforced:  TOOLS REACH DATA, NEVER MODELS",
      "originalText": "BOUNDARY 2 — network enforced:  TOOLS REACH DATA, NEVER MODELS",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": "box-021",
      "lineHeight": 1.25
    },
    {
      "id": "txt-023",
      "type": "text",
      "x": 96,
      "y": 708,
      "width": 2728,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 380163673,
      "versionNonce": 1335230944,
      "version": 1,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "No MCP tool wraps a model invocation. If a tool needs model output it calls the router like any other caller, and that call is routed, priced and recorded.\nThis is what keeps the cost scoreboard a total rather than a sample: there is no side door through which an unmetered model call can be made.",
      "originalText": "No MCP tool wraps a model invocation. If a tool needs model output it calls the router like any other caller, and that call is routed, priced and recorded.\nThis is what keeps the cost scoreboard a total rather than a sample: there is no side door through which an unmetered model call can be made.",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
    },
    {
      "id": "box-024",
