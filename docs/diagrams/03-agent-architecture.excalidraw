      "versionNonce": 232821323,
      "version": 1,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Each alert is scored against a fixed rubric with the temperature\npinned. 500 alerts do not fit one context window and do not try to:\nthe service chunks them and routes each chunk independently —\nwhich is also what makes the cost scoreboard interesting.",
      "originalText": "Each alert is scored against a fixed rubric with the temperature\npinned. 500 alerts do not fit one context window and do not try to:\nthe service chunks them and routes each chunk independently —\nwhich is also what makes the cost scoreboard interesting.",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
    },
