      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Cosmos  ·  auditEvents  (append-only)",
      "originalText": "Cosmos  ·  auditEvents  (append-only)",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
