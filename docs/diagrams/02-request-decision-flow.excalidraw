      "versionNonce": 376171863,
      "version": 1,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Runs FIRST, against the full multi-vendor catalog. Excludes, in order:\n· region not in policy.AllowedRegions  → the whole catalog is excluded\n· vendor not in policy.ApprovedVendors\n· classification > policy.MaxClassification[vendor]\n· cost > policy.MaxCostPerRequestUsd\nEvery exclusion carries prose fit to read aloud to a governance audience.",
      "originalText": "Runs FIRST, against the full multi-vendor catalog. Excludes, in order:\n  · region not in policy.AllowedRegions  → the whole catalog is excluded\n  · vendor not in policy.ApprovedVendors\n  · classification > policy.MaxClassification[vendor]\n  · cost > policy.MaxCostPerRequestUsd\nEvery exclusion carries prose fit to read aloud to a governance audience.",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
    },
