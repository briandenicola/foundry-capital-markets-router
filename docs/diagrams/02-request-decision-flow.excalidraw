      "lineHeight": 1.25
    },
    {
      "id": "txt-023",
      "type": "text",
      "x": 1056,
      "y": 695,
      "width": 968,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
