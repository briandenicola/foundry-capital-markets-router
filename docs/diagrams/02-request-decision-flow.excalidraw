      "versionNonce": 429926384,
      "version": 1,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Sees ONLY the policy-eligible candidates. Prefers the indicated tier; if it is\nunaffordable or unavailable it takes the most capable tier that is both.\nThe ceiling is a control, not a report.",
      "originalText": "Sees ONLY the policy-eligible candidates. Prefers the indicated tier; if it is\nunaffordable or unavailable it takes the most capable tier that is both.\nThe ceiling is a control, not a report.",
      "fontSize": 16,
