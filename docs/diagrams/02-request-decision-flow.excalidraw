      "version": 1,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "A denial is never silently absorbed; it is always surfaced to the UI. Principle VI: one correlationId spans the whole lifecycle.",
      "originalText": "A denial is never silently absorbed; it is always surfaced to the UI. Principle VI: one correlationId spans the whole lifecycle.",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
    },
