      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Internal Container Apps ingress. There is no public FQDN.\nRejects a caller without the Router.Invoke app role with 403.\nRoutingPlanner.Plan() is the single entry point and the one place\nthe evaluation order is decided — calling TierSelector directly\nwould bypass the gate.",
      "originalText": "Internal Container Apps ingress. There is no public FQDN.\nRejects a caller without the Router.Invoke app role with 403.\nRoutingPlanner.Plan() is the single entry point and the one place\nthe evaluation order is decided — calling TierSelector directly\nwould bypass the gate.",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
    },
