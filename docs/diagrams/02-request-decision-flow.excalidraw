      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Cosmos  ·  routerDecisions",
      "originalText": "Cosmos  ·  routerDecisions",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": "box-048",
      "lineHeight": 1.25
    },
    {
      "id": "txt-050",
      "type": "text",
      "x": 136,
      "y": 1721,
      "width": 901.33,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1065991140,
      "versionNonce": 1952888800,
      "version": 1,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Partitioned by /correlationId.\nInputs, candidate tiers with per-candidate rejection\nreasons, policy exclusions, outcome, rationale,\npolicySetId and policySetVersion.\nGET /v1/decisions/{correlationId} (Router.Read).",
      "originalText": "Partitioned by /correlationId.\nInputs, candidate tiers with per-candidate rejection\nreasons, policy exclusions, outcome, rationale,\npolicySetId and policySetVersion.\nGET /v1/decisions/{correlationId} (Router.Read).",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
    },
    {
