    {
      "id": "txt-029",
      "type": "text",
      "x": 1056,
      "y": 1129,
      "width": 968,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
