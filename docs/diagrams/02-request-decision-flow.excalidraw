      "roundness": null,
      "seed": 1733919202,
      "versionNonce": 550488001,
      "version": 1,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The selected deployment is invoked over the Foundry private endpoint.\nAPIM metering / content safety is specified but not yet in Terraform.\nNo silent retry on a different tier — that would corrupt the cost figures.",
      "originalText": "The selected deployment is invoked over the Foundry private endpoint.\nAPIM metering / content safety is specified but not yet in Terraform.\nNo silent retry on a different tier — that would corrupt the cost figures.",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
    },
