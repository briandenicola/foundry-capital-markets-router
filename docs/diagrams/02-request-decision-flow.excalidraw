      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "POST /v1/route   (Entra token, Router.Invoke app role)\n{\n\"correlationId\": \"b6b1f0a2-…\",\n\"lane\": \"Research\",\n\"taskKind\": \"synthesize\",\n\"payload\": { \"question\": \"…\" },\n\"costCeilingUsd\": 0.25,\n\"latencyBudgetMs\": 8000,\n\"dataClassification\": \"Internal\",\n\"policySetId\": \"CapitalMarkets-US\",\n\"complexityHints\": {\n\"inputTokenEstimate\": 12000,\n\"requiresMultiStep\": true,\n\"requiresRetrieval\": true,\n\"requiresToolCalls\": false\n}\n}",
      "originalText": "POST /v1/route   (Entra token, Router.Invoke app role)\n{\n  \"correlationId\": \"b6b1f0a2-…\",\n  \"lane\": \"Research\",\n  \"taskKind\": \"synthesize\",\n  \"payload\": { \"question\": \"…\" },\n  \"costCeilingUsd\": 0.25,\n  \"latencyBudgetMs\": 8000,\n  \"dataClassification\": \"Internal\",\n  \"policySetId\": \"CapitalMarkets-US\",\n  \"complexityHints\": {\n    \"inputTokenEstimate\": 12000,\n    \"requiresMultiStep\": true,\n    \"requiresRetrieval\": true,\n    \"requiresToolCalls\": false\n  }\n}",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
    },
