<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Fcmr.ServiceDefaults</RootNamespace>
    <AssemblyName>Fcmr.ServiceDefaults</AssemblyName>
  </PropertyGroup>

  <!--
    Cross-cutting host plumbing shared by all five services: correlation, the managed-platform
    guard, telemetry, and health probes.

    Unlike the lane domain assemblies this one is NOT dependency-free — it exists precisely to own
    the ASP.NET Core and Azure SDK wiring so the domain assemblies never have to. Nothing here
    makes a governance decision; anything that does belongs in a domain assembly where it can be
    tested without a host.
  -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" />
    <PackageReference Include="Microsoft.Identity.Web" />
  </ItemGroup>

</Project>
