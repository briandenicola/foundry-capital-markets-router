<?xml version="1.0" encoding="utf-8"?>
<!--
  Coverage collection settings.

  Generated code is excluded. This is not a way of making the number look better: the regex source
  generator emits several thousand lines of vectorised fast paths per pattern, most of which are
  unreachable on any given input, and none of which anyone wrote or can meaningfully test. Counting
  them measures the source generator rather than this repository, and it does so in the direction
  that hides real gaps — a handful of untested branches in hand-written code disappears into the
  noise of a much larger generated file.

  The 70% gate is meant to constrain the code we are responsible for, so that is what it measures.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <ExcludeByFile>**/*.g.cs,**/*.designer.cs</ExcludeByFile>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
